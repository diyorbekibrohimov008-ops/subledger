{
  "name": "subledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/nodeServer.ts",
    "dev:client": "vite",
    "start": "node dist/server.mjs",
    "build:client": "vite build",
    "build:server": "esbuild src/server/nodeServer.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --packages=external",
    "build:railway": "node scripts/bundle-railway-function.mjs",
    "build": "npm run build:client && npm run build:server && npm run build:railway",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/urbanist": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@vercel/blob": "^2.9.0",
    "hono": "^4.7.4",
    "lucide-react": "^0.475.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
